# Vorlage: als .env kopieren und mit den Werten des EIGENEN Backends füllen.
# Die .env selbst gehört nie ins Repo. Auf Netlify trägst du die Werte unter
# Site settings > Environment variables ein.
VITE_SUPABASE_URL="https://DEIN-SUPABASE-PROJEKT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="DEIN-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="DEIN-SUPABASE-PROJEKT"
# Optional
VITE_BUG_REPORT_EMAIL=""
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=""
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=""
